# ── Tanis Hub environment ──────────────────────────────────────────────────
# Copy to .env and fill in. Variables marked (required) stop the server (or a
# feature) when missing in production; everything else has a safe default.

# ── Core (required) ──
DATABASE_URL=mysql://user:password@host:4000/tanis    # TiDB/MySQL connection string
JWT_SECRET=                                           # 32+ random chars — signs Hub + agent sessions
VITE_APP_ID=                                          # Manus app id (OAuth client id)
OAUTH_SERVER_URL=                                     # Manus OAuth server base URL
NODE_ENV=production
PORT=3000

# ── Core (optional) ──
OWNER_OPEN_ID=                 # openId auto-granted the "owner" role
BASE_URL=                      # public URL of the Hub (used in links)
ALLOWED_ORIGIN=                # comma-separated extra CORS origins
TRUST_PROXY=                   # "true" behind a reverse proxy (default on in production)
BUSINESS_TZ=Africa/Cairo       # business calendar for pay cycles / jobs
DB_POOL_SIZE=10                # mysql2 pool connections
RUN_JOBS=true                  # "false" on extra replicas: disables the hourly job scheduler
ALLOW_INSECURE_DEV_SECRET=     # "true" ONLY for local dev without JWT_SECRET

# ── Agent portal ──
AGENT_PORTAL_LOCKED=           # "true" = env-level hard lock (DB toggle also exists in Settings)
BLOCK_DEMO_AGENT_LOGIN=        # "true" = refuse isDemo test agents entirely
TEST_AGENT_CODE=               # seeded demo login for staging only
TEST_AGENT_PASSWORD=

# ── Slack ──
SLACK_BOT_TOKEN=               # xoxb-… for DM reminders + lookups
SLACK_CHANNEL_ID=              # fallback channel when an agent has no Slack DM
SLACK_ADMIN_CHANNEL_ID=        # admin alerts channel
SLACK_ADMIN_WEBHOOK=           # incoming webhook for admin alerts
SLACK_MANAGEMENT_WEBHOOK=      # incoming webhook for management pings (job failures, approvals)
SLACK_SIGNING_SECRET=          # verifies Slack event callbacks
SLACK_APPROVER_USER_IDS=       # comma-separated Slack user ids allowed to approve via emoji
SLACK_TRIGGER_EMOJI=           # emoji that triggers the approval flow
SLACK_TRIGGER_MESSAGE=         # message pattern for the trigger
SLACK_TRIGGER_WEBHOOK=         # webhook used by the trigger flow

# ── Integrations ──
GOOGLE_CLIENT_ID=              # Google Calendar import
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=           # Microsoft/Outlook calendar import
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
HUBSPOT_API_TOKEN=

# ── Data pushes / misc ──
UPLOAD_SECRET=                 # shared secret for the Apps Script nightly push (X-API-Key system also exists)
BUILT_IN_FORGE_API_URL=        # LLM features (voice transcription etc.)
BUILT_IN_FORGE_API_KEY=
